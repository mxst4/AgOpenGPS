    <Compile Include="../../SourceCode/AgOpenGPS.Core/Models/Base/GeoArea.cs" Link="Production/GeoArea.cs" />
    <Compile Include="../../SourceCode/AgOpenGPS.Core/Models/Base/Units.cs" Link="Production/Units.cs" />
    <Compile Include="../../SourceCode/AgOpenGPS.Core/Models/Field/SharedFieldProperties.cs" Link="Production/SharedFieldProperties.cs" />
    <Compile Include="../../SourceCode/AgOpenGPS.Core.Tests/FarmTelemetry/*.cs" Link="Tests/%(Filename)%(Extension)" />
    <None Include="../../SourceCode/AgOpenGPS.Core.Tests/FarmTelemetry/Fixtures/*" Link="FarmTelemetry/Fixtures/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
